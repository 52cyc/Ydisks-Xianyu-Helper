# 复制为 .env 后再填写。不要提交包含真实密钥的 .env。
COMPOSE_PROJECT_NAME=ydisks-xianyu-helper-sqlite

# 必须长期固定。更换后，数据库中已经加密的账号凭据可能无法解密。
XIANYU_DATA_KEY=请替换为稳定且足够长的随机密钥

# 首次启动时自动创建 admin；不少于 8 个字符。
XIANYU_ADMIN_PASSWORD=请替换为管理员密码

# 默认仅允许本机访问。需要局域网访问时改为 0.0.0.0，并配置防火墙。
XIANYU_BIND_ADDRESS=127.0.0.1
XIANYU_HTTP_PORT=59188

XIANYU_UPLOAD_DIR=/app/data/uploads
TZ=Asia/Shanghai
LOG_LEVEL=info
LOG_FORMAT=json
BROWSER_HEADLESS=true
